# Copy to .env. Read by docker compose and `npm run dev:api`.

# Database
POSTGRES_DB=terria
POSTGRES_USER=terria
POSTGRES_PASSWORD=terria
DB_PORT=5432
# Docker volume holding the database; change it to switch test datasets.
DB_VOLUME=terria-layer-manager-db

# App
APP_PORT=3000
# Used by `npm run dev:api` (from the host, so localhost rather than `db`).
DATABASE_URL=postgres://terria:terria@localhost:5432/terria
# Session cookie is Secure by default in production. Set false only when serving
# production over plain http to a host other than localhost.
# COOKIE_SECURE=false
# Folder that published and test init files are written to, served at /config.
# Relative to the working directory; defaults to ./config.
# CONFIG_DIR=config
