{
  "name": "terria-layer-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.ts",
    "start": "node server/index.ts",
    "user:create": "node --env-file-if-exists=.env server/create-user.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate:traits": "node scripts/generate-traits.mjs --all",
    "test": "vitest run",
    "test:unit": "vitest run --project web --project server",
    "test:api": "vitest run --project api",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "docs:setup": "python3 -m venv .venv && .venv/bin/pip install -r docs/requirements.txt",
    "docs": "test -x .venv/bin/sphinx-build || { echo 'Run npm run docs:setup first, to install Sphinx in .venv'; exit 1; } && .venv/bin/sphinx-build -W --keep-going -b html docs docs/_build/html"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
